# Canonical URL. Defaults to the production domain; set it on a preview
# deployment so canonical tags and the sitemap describe that deployment.
PUBLIC_SITE_URL=https://trindustrialconstruction.com

# Growthmap lead endpoint the contact form POSTs to (playbook §4b). Public by
# design — it is read in the browser.
#
# While this is empty the pages keep the original LeadConnector ("Trustymail")
# iframe, so a deploy before the endpoint exists never ships a dead form. Set it
# in Vercel and our own static form takes over on the next build.
PUBLIC_CONTACT_ENDPOINT=

# Force the original LeadConnector embed back even once the endpoint is set.
# `growthmap` (default) or `embed`.
PUBLIC_FORM_MODE=growthmap
