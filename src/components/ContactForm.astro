---
/**
 * Growthmap lead form (playbook §4b).
 *
 * Fully static: the browser POSTs FormData straight to `PUBLIC_CONTACT_ENDPOINT`,
 * so the site needs no adapter and no serverless function. Replaces the
 * LeadConnector ("Trustymail") iframe the WordPress footer embeds — the field set,
 * labels, order and styling were read off the live widget with
 * scripts/inspect-form.mjs, so the section keeps its look and its height.
 *
 * With no endpoint configured the caller keeps the original embed instead, so a
 * deploy before the endpoint exists never ships a dead form.
 */
import { CONTACT_ENDPOINT } from '../config';

interface Props {
  /** Height of the widget it replaces, so the page geometry does not jump. */
  minHeight: number;
  /**
   * Which region this instance renders in. `/contact/` carries two copies of the
   * widget — one in its content and the footer's, which the theme's custom CSS
   * hides on that page — so the label/input ids have to differ between them.
   */
  region: string;
}

const { minHeight, region } = Astro.props as Props;

/**
 * The widget's own field set. Its two free-text questions are stored against
 * GoHighLevel custom-field ids; here they get readable names, since the Growthmap
 * endpoint receives the labels alongside the values.
 */
const FIELDS = [
  { name: 'first_name', tag: 'input', type: 'text', label: 'First Name', autocomplete: 'given-name' },
  { name: 'last_name', tag: 'input', type: 'text', label: 'Last Name', autocomplete: 'family-name' },
  { name: 'email', tag: 'input', type: 'email', label: 'Email', autocomplete: 'email' },
  { name: 'phone', tag: 'input', type: 'tel', label: 'Phone', autocomplete: 'tel' },
  { name: 'project_description', tag: 'textarea', label: 'Please describe your project', rows: 4 },
  { name: 'address', tag: 'input', type: 'text', label: 'Project Location', autocomplete: 'street-address' },
  { name: 'project_involvement', tag: 'textarea', label: 'How will you be involved with the project?', rows: 4 },
] as const;

const FORM_NAME = 'Contact Us Form';
---

<div class="gm-form" style={`min-height:${minHeight}px`}>
  <form
    class="gm-form__form"
    method="post"
    action={CONTACT_ENDPOINT}
    data-endpoint={CONTACT_ENDPOINT}
  >
    <input type="hidden" name="form_name" value={FORM_NAME} />
    <input type="hidden" name="source_page" value="" data-fill="path" />

    {FIELDS.map((field) => (
      <p class="gm-form__field">
        <label class="gm-form__label" for={`gm-${region}-${field.name}`}>
          {field.label} <span aria-hidden="true">*</span>
        </label>
        {field.tag === 'textarea' ? (
          <textarea id={`gm-${region}-${field.name}`} name={field.name} rows={field.rows} required />
        ) : (
          <input
            id={`gm-${region}-${field.name}`}
            name={field.name}
            type={field.type}
            autocomplete={field.autocomplete}
            required
          />
        )}
      </p>
    ))}

    {/* Honeypot — hidden from people, irresistible to bots. */}
    <div class="gm-form__hp" aria-hidden="true">
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <button type="submit" class="gm-form__submit">Submit</button>

    <p class="gm-form__status" role="status" aria-live="polite"></p>
  </form>
</div>

<style>
  /* The widget renders on the footer's near-black band, inset to ~800px and
     centred — matched here so replacing it does not move anything around it. */
  .gm-form {
    display: flex;
    align-items: flex-start;
    width: 100%;
  }

  .gm-form__form {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    font-family: 'Roboto', sans-serif;
    color: #fff;
  }

  .gm-form__field {
    margin: 0 0 20px;
  }

  .gm-form__label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.8;
  }

  .gm-form__form input,
  .gm-form__form textarea {
    display: block;
    width: 100%;
    padding: 12px 10px;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.5;
    color: #fff;
    background: transparent;
    border: 1px solid #fff;
    border-radius: 5px;
  }

  .gm-form__form textarea {
    height: 108px;
    resize: vertical;
  }

  .gm-form__form input:focus-visible,
  .gm-form__form textarea:focus-visible {
    outline: 2px solid #ee7b21;
    outline-offset: 1px;
  }

  /* `:user-invalid` rather than `:invalid`: an untouched required field is
     invalid from the first paint, and must not be painted as an error. */
  .gm-form__form input:user-invalid,
  .gm-form__form textarea:user-invalid {
    border-color: #ee7b21;
  }

  .gm-form__hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* `.gm-form__submit:focus` is pinned to the resting look on purpose: the Hello
     theme styles every bare `button:hover`/`:focus` with its own accent colour,
     which would repaint the widget's orange. `:focus-visible` still shows. */
  .gm-form__submit,
  .gm-form__submit:hover,
  .gm-form__submit:focus {
    margin-top: 20px;
    padding: 20px 40px;
    font-family: 'Roboto', sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.8;
    color: #fff;
    background: #ee7b21;
    border: 0;
    border-radius: 5px;
    cursor: pointer;
  }

  .gm-form__submit:hover { background: #be621a; }
  .gm-form__submit:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .gm-form__submit[disabled] { opacity: 0.6; cursor: progress; }

  .gm-form__status {
    margin: 12px 0 0;
    min-height: 1.4em;
    font-size: 14px;
  }

  .gm-form__status[data-state='error'] { color: #ee7b21; }
  .gm-form__status[data-state='ok'] { color: #7ed6a5; }
</style>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.gm-form__form')) {
    const status = form.querySelector<HTMLParagraphElement>('.gm-form__status')!;
    const submit = form.querySelector<HTMLButtonElement>('.gm-form__submit')!;
    const endpoint = form.dataset.endpoint || '';

    form.querySelector<HTMLInputElement>('[data-fill="path"]')!.value = location.pathname;

    const say = (message: string, state: 'ok' | 'error' | '') => {
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      say('', '');

      if (!form.reportValidity()) return;

      // A filled honeypot is a bot: show success, send nothing.
      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]')!;
      if (honeypot.value.trim()) {
        form.reset();
        say('Thanks — we will be in touch shortly.', 'ok');
        return;
      }

      if (!endpoint) {
        say('This form is not connected yet. Please call or email us instead.', 'error');
        return;
      }

      submit.disabled = true;
      const original = submit.textContent;
      submit.textContent = 'Sending…';

      try {
        const response = await fetch(endpoint, { method: 'POST', body: new FormData(form) });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.reset();
        say('Thanks — we will be in touch shortly.', 'ok');
      } catch {
        say('Sorry, something went wrong. Please try again or call us.', 'error');
      } finally {
        submit.disabled = false;
        submit.textContent = original;
      }
    });
  }
</script>
